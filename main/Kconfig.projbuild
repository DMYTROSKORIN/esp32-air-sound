menu "esp32-air-sound"

    config AIRSOUND_FREQ_10KHZ
        int "FM frequency, in 10 kHz units (10000 = 100.00 MHz)"
        range 7600 10800
        default 10000
        help
            Pick a frequency with nothing on it. 76.00 to 108.00 MHz in 50 kHz steps,
            so the value must be a multiple of 5.

    config AIRSOUND_TX_POWER_DBUV
        int "Transmit power, dBuV (88..115)"
        range 88 115
        default 105

    config AIRSOUND_PREEMPHASIS_50US
        bool "50 us pre-emphasis (Europe); off = 75 us (Americas)"
        default y

    config AIRSOUND_RDS_PI
        hex "RDS programme identification code"
        default 0xADAF

    config AIRSOUND_RDS_PS
        string "RDS programme service name (8 characters)"
        default "AIRSOUND"

    config AIRSOUND_RDS_RT
        string "RDS radiotext (up to 64 characters)"
        default "esp32-air-sound  test tone 1 kHz"

    config AIRSOUND_TONE_HZ
        int "Test tone frequency, Hz"
        range 100 10000
        default 1000

    config AIRSOUND_TONE_DB
        int "Test tone level, dB below full scale (positive number)"
        range 0 60
        default 14
        help
            The PCM5102 puts out 2.1 Vrms at full scale, the Si4713 line input clips at
            636 mVpk. 14 dB down keeps the transmitter's limiter out of the picture.

endmenu
